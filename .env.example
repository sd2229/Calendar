# Copy to .env and fill in. NEVER commit the real .env (it's gitignored).
# These are used by the seed script and the /calendar.ics function — they are
# SERVER-SIDE only. The browser never sees the service-role key.

# Supabase project (Project Settings -> API)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google emails allowed to sign in and edit (comma-separated). Used by seed.mjs.
ALLOWED_EMAILS=you@example.com,housemate@example.com

# Shared secret that the .ics subscription URL must carry: /calendar.ics?token=...
# Generate one, e.g.:  node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
ICS_TOKEN=change-me-to-a-long-random-string
